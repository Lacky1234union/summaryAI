# Summuraze — пример конфигурации. Скопировать в .env и заполнить.
# Все переменные читает типизированный конфиг (#3): неизвестная или битая переменная
# роняет процесс на старте, а не посреди часовой транскрибации.

# ── Пути ────────────────────────────────────────────────────────────────────
# Кэш артефактов по стадиям. Ключ = sha256(вход + версия стадии + параметры),
# поэтому правка промпта не перезапускает ASR. Растёт быстро — чистится `summuraze gc`.
SUMMURAZE_DATA_DIR=./data
# Куда кладутся заметки — папка внутри Obsidian-хранилища. Пусто = ./data/notes.
# SUMMURAZE_OUTPUT_DIR=/home/<user>/Documents/Obsidian/<vault>/Лекции
SUMMURAZE_OUTPUT_DIR=

# ── Заметка Obsidian (#18) ───────────────────────────────────────────────────
# Рядом с заметкой — сжатое аудио (Opus в .ogg) и .srt: таймкоды заметки — ссылки
# Media Extended, клик открывает запись на этой секунде. false — таймкоды текстом.
SUMMURAZE_NOTE_AUDIO=true
# 32 кбит/с ≈ 14 МБ на час речи — LiveSync переносит без проблем.
SUMMURAZE_NOTE_AUDIO_BITRATE_KBPS=32
# Подпапка SUMMURAZE_OUTPUT_DIR для аудио и субтитров.
SUMMURAZE_NOTE_MEDIA_DIR=Записи

# ── Запись (#37) ────────────────────────────────────────────────────────────
# summuraze record пишет микрофон и звук системы двумя дорожками (Opus в .mka).
SUMMURAZE_RECORD_DIR=~/Recordings
# Источники из `pactl list short sources`. Пусто — системные по умолчанию; system=none — без звука системы.
SUMMURAZE_RECORD_MIC=
SUMMURAZE_RECORD_SYSTEM=
SUMMURAZE_RECORD_BITRATE_KBPS=32
# Все дорожки молчат дольше N минут — запись останавливается сама. 0 — никогда.
SUMMURAZE_RECORD_SILENCE_STOP_MINUTES=15

# ── Срок хранения (#49) ─────────────────────────────────────────────────────
# Через N дней аудио своих записей (оригинал из SUMMURAZE_RECORD_DIR, wav в кэше, аудио и
# субтитры в хранилище) удаляется в конце прогона; заметки и транскрипты остаются, таймкоды в
# заметке становятся текстом. Пусто — не удалять. Вручную: summuraze prune --before 2026-10-01.
SUMMURAZE_RETENTION_DAYS=

# ── VAD (#10) ───────────────────────────────────────────────────────────────
# Silero отсекает тишину и музыку до ASR: на них Whisper галлюцинирует.
# false — расшифровывать запись целиком (только для диагностики).
SUMMURAZE_VAD_ENABLED=true
SUMMURAZE_VAD_THRESHOLD=0.5
# Пауза короче этой не разрывает интервал речи.
SUMMURAZE_VAD_MIN_SILENCE_MS=1000
# Интервалы короче этого — щелчки и кашель, выбрасываются.
SUMMURAZE_VAD_MIN_SPEECH_MS=250
# Запас по краям интервала, чтобы не откусить первый и последний слог.
SUMMURAZE_VAD_SPEECH_PAD_MS=400

# ── STT (#11) ───────────────────────────────────────────────────────────────
# Дефолтная модель выбирается ЗАМЕРОМ на этом железе (#9), а не по популярности.
# Правило выбора: лучшее качество при RTF <= 0.5 (час записи за <= 30 мин).
# faster-whisper — распознавание (#11); echo — заглушка без модели, для проверки конвейера.
# Модель скачивается с HuggingFace при первом прогоне (large-v3-turbo — ~1.6 ГБ).
SUMMURAZE_ASR_PROVIDER=faster-whisper
SUMMURAZE_ASR_MODEL=large-v3-turbo
SUMMURAZE_ASR_COMPUTE_TYPE=int8
SUMMURAZE_ASR_DEVICE=cpu
# Пусто = автоопределение языка. Прибивается флагом, когда язык известен заранее.
SUMMURAZE_ASR_LANGUAGE=ru
# 0 = по числу физических ядер (гиперпотоки не ускоряют). Замер — docs/BENCHMARKS.md.
SUMMURAZE_ASR_THREADS=0
# Общий словарь терминов (#13): по строке на термин, «слышится -> пишется» — замена.
# Можно заметкой в Obsidian. Словарь курса — флаг --terms, он идёт первым.
# В подсказку Whisper влезает ~10 терминов (порядок = приоритет); замены — без ограничений.
SUMMURAZE_ASR_TERMS_FILE=

# ── LLM (#15) ───────────────────────────────────────────────────────────────
# Переключение локально <-> API — это ЗНАЧЕНИЯ ЗДЕСЬ, а не ветка в коде:
# OpenRouter, DeepSeek, Yandex и локальный llama.cpp говорят по одному протоколу.
#
#   OpenRouter (дефолт): https://openrouter.ai/api/v1   + deepseek/deepseek-v4.1-flash
#   DeepSeek напрямую:   https://api.deepseek.com/v1    + deepseek-flash
#   локально:            http://127.0.0.1:8080/v1       + имя модели в llama.cpp
#
# Внимание: алиас deepseek-chat retired 24.07.2026 — не использовать.
# openai-compat — всё перечисленное (#15); echo — заглушка без сети.
SUMMURAZE_LLM_PROVIDER=openai-compat
SUMMURAZE_LLM_BASE_URL=https://openrouter.ai/api/v1
SUMMURAZE_LLM_MODEL=deepseek/deepseek-v4.1-flash
# Ключ OpenRouter — то же имя, что в meditron / vobot / tgit (https://openrouter.ai/keys).
# Или SUMMURAZE_LLM_API_KEY. Для локального сервера не нужен.
OPENROUTER_API_KEY=
# OpenRouter режет IP из РФ: с такого хоста — HTTP(S)/SOCKS5-прокси для запросов к LLM.
# http://user:pass@host:port или socks5://… Пусто — напрямую. Понимает и LLM_PROXY_URL.
SUMMURAZE_LLM_PROXY_URL=
# Точности моделей у провайдеров OpenRouter: fp4 однажды выдал мусор вместо конспекта.
# JSON-список; [] — без фильтра.
SUMMURAZE_LLM_OPENROUTER_QUANTIZATIONS=["fp8","bf16","fp16","fp32","unknown"]
# Контекст провайдера в токенах: от него считается порог single-pass против иерархии (#16).
# У DeepSeek V4.1-Flash — 1M, у локальной 8B — на два порядка меньше.
SUMMURAZE_LLM_CONTEXT=1000000

# ── Приватность ─────────────────────────────────────────────────────────────
# true запрещает сетевых провайдеров НА УРОВНЕ ФАБРИКИ (#20). Локальный STT сам по себе
# приватности не даёт: саммари по API увозит транскрипт целиком.
SUMMURAZE_LOCAL_ONLY=false
